  "description": "Shared project memory for coding agents: a block tree of designs, plans and decisions with role-shaped views, served over MCP.",
  "keywords": [
    "context",
    "context-management",
    "agents",
    "llm",
    "mcp",
    "multi-agent",
    "project-memory",
    "cli"
  ],
  "license": "MIT",
  "author": {
    "name": "Mohammad Ewais"
  },
  "homepage": "https://github.com/mewais/Hafiz/tree/main/packages/hafiz#readme",
  "bugs": {
    "url": "https://github.com/mewais/Hafiz/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mewais/Hafiz.git",
    "directory": "packages/hafiz"
  },
  "type": "module",
  "bin": {
    "hafiz": "./dist/hafiz.js"
  },
  "exports": {
    "./bin": "./dist/hafiz.js",
