{
  "name": "@hafiz/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Hafiz core: domain model, schemas, commands/queries, view engine, sessions",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./state": {
      "types": "./dist/store/state.d.ts",
      "import": "./dist/store/state.js"
    },
    "./conformance": {
      "types": "./dist/store/conformance.d.ts",
      "import": "./dist/store/conformance.js"
    }
  },
  "files": [
    "dist",
    "config"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "vitest": "^3.2.7"
  }
}
