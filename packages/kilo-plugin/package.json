{
  "name": "@hafiz/kilo-plugin",
  "version": "0.1.0",
  "description": "Kilo plugin for Hafiz: role agents, Hafiz tools, and context shaping for the project block tree.",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mewais/Hafiz.git"
  },
  "scripts": {
    "build": "tsc -b ../.. && node ../../scripts/bundle.mjs kilo-plugin"
  },
  "dependencies": {
    "hafiz": "workspace:^0.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
